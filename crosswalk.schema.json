{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelvinuduma.github.io/ism-cyber-crosswalk/crosswalk.schema.json",
  "title": "ISM Code ↔ NIST CSF 2.0 Crosswalk",
  "type": "object",
  "required": ["meta", "rows"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version", "lastVerified", "frameworks", "disclaimer"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "minLength": 1 },
        "disclaimer": { "type": "string", "minLength": 1 },
        "frameworks": {
          "type": "object",
          "required": ["source", "registry"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "registry": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "name", "type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "type": { "type": "string", "enum": ["target"] },
                  "citation": { "type": ["string", "null"] },
                  "version": { "type": ["string", "null"] },
                  "url": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "function", "title", "gap", "mappings", "sourceTrace"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "function": {
            "type": "string",
            "enum": ["Govern", "Identify", "Protect", "Detect", "Respond", "Recover"]
          },
          "title": { "type": "string", "minLength": 1 },
          "gap": { "type": "boolean" },
          "relationship": { "type": ["string", "null"] },
          "vesselContext": { "type": ["string", "null"] },
          "mappings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["object", "null"],
              "properties": {
                "references": {
                  "type": ["array", "string", "null"]
                },
                "relationship": { "type": ["string", "null"] },
                "vesselContext": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            }
          },
          "sourceTrace": {
            "type": "object",
            "required": ["confidence", "lastReviewed", "evidence"],
            "properties": {
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "lastReviewed": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["source", "references"],
                  "properties": {
                    "source": { "type": "string", "minLength": 1 },
                    "references": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
